# TECHNOVA STUDIO // ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development or set these variables in Vercel / Netlify dashboard.

# ─── OPTIONAL: SUPABASE CLOUD DATABASE ─────────────────────────────────────────
# If left empty, Technova Studio runs seamlessly in high-speed LocalStorage fallback mode.
# To connect to live cloud database:
# 1. Create a free project at https://supabase.com
# 2. Copy the Project URL and Anon Public Key from Project Settings -> API.
# 3. Run the SQL schema from 'supabase_schema.sql' in Supabase SQL Editor.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OPTIONAL: PRODUCTION METADATA & ANALYTICS ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://technovastudio.com
NEXT_PUBLIC_CONTACT_EMAIL=ops@technovastudio.dev
