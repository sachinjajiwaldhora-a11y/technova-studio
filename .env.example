# TECHNOVA STUDIO // ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development or set these variables in Vercel / Netlify dashboard.

# ─── MONGODB CLOUD DATABASE (PRIMARY) ──────────────────────────────────────────
# Connect to your MongoDB Atlas cluster or local MongoDB instance:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=technova_studio

# ─── OPTIONAL: SUPABASE CLOUD DATABASE (LEGACY / FALLBACK) ─────────────────────
# If left empty, Technova Studio runs seamlessly with MongoDB or LocalStorage fallback mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── PRODUCTION METADATA & ANALYTICS ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://technovastudio.com
NEXT_PUBLIC_CONTACT_EMAIL=ops@technovastudio.dev
